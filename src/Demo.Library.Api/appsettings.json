{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ActivityLogging": {
    "CaptureRequestBody": true,
    "CaptureResponseBody": true,
    "MaxBodyLength": 16384
  },
  "CosmosDatabase": {
    "ConnectionString": "",
    "DatabaseName": "DemoLibrary",
    "EndpointActivity": "EndpointActivity",
    "Books": "Books",
    "Loans": "Loans",
    "AccountClosureRequests": "AccountClosureRequests",
    "EnsureCreated": true
  },
  "EntraAuthentication": {
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "common",
    "Audience": "api://<your-api-app-client-id>",
    "RequiredApiScope": "api.library.account",
    "RequiredMcpScope": "mcp.library.account",
    "ApiResourceDocumentationUrl": "https://docs.example.com/api/library-rest",
    "JwtResourceMetadataPath": "/.well-known/oauth-protected-resource/api"
  },
  "Mcp": {
    "ServerName": "demo-library-mcp",
    "ServerVersion": "1.0.0",
    "StatelessTransport": true,
    "ResourceDocumentationUrl": "https://docs.example.com/api/library-mcp",
    "ResourceMetadataPath": "/.well-known/oauth-protected-resource/mcp",
    "AuthorizationMode": "ToolLevel"
  },
  "AllowedHosts": "*"
}
